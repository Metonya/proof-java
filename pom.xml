<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.proofjava</groupId>
  <artifactId>proof-java-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>proof-java</name>
  <description>Deterministic verdict layer for Java test suites.</description>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modules>
    <module>proof-java-cli</module>
  </modules>

  <properties>
    <!-- D-03: Java 17 is the minimum runtime. Encoding is declared explicitly
         because the platform default (Cp1254 on the benchmark machine) must
         never influence a build or a parse. -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <picocli.version>4.7.7</picocli.version>
    <junit.version>5.12.2</junit.version>
    <jackson.version>2.18.4</jackson.version>
    <json-schema-validator.version>1.5.6</json-schema-validator.version>
    <javaparser.version>3.26.2</javaparser.version>

    <!-- D-51/D-55: L2's engine, embedded and shaded into proof-java.jar itself -
         never a build-tool plugin the target repo installs (Apache-2.0, hard
         rule 9 clear). Pinned to 1.15.8, the version M2's four gates were
         proven against (D-53); 1.25.9 lifts the Java 25 ASM ceiling but hits
         a new, unresolved zero-block collection failure under it (D-54). -->
    <pitest.version>1.15.8</pitest.version>
    <pitest.junit5.plugin.version>1.2.1</pitest.junit5.plugin.version>

    <!-- Test-only fixture harness (docs/rules/README.md fixture convention): downloaded
         as jars via maven-dependency-plugin, never added as project dependencies, so the
         oracle engine's own resolution never accidentally benefits from these being on
         coverdict's own classpath (K4) - the import-anchored resolution tier (D-28) is
         what a real, classpath-less user run actually exercises. -->
    <fixture.junit4.version>4.13.2</fixture.junit4.version>
    <fixture.assertj.version>3.26.3</fixture.assertj.version>
    <fixture.mockito.version>5.14.2</fixture.mockito.version>
    <fixture.hamcrest.version>2.2</fixture.hamcrest.version>
    <fixture.truth.version>1.4.5</fixture.truth.version>
    <dependency.plugin.version>3.8.1</dependency.plugin.version>
    <license.plugin.version>2.5.0</license.plugin.version>
    <antrun.plugin.version>3.1.0</antrun.plugin.version>

    <!-- coverdict scans itself with a local SonarQube; host URL and token stay
         outside the repo (SONAR_HOST_URL / SONAR_TOKEN). -->
    <sonar.projectKey>proof-java</sonar.projectKey>
    <sonar.coverage.exclusions>**/Main.java</sonar.coverage.exclusions>

    <compiler.plugin.version>3.14.0</compiler.plugin.version>
    <resources.plugin.version>3.5.0</resources.plugin.version>
    <surefire.plugin.version>3.5.6</surefire.plugin.version>
    <shade.plugin.version>3.6.2</shade.plugin.version>
    <jacoco.plugin.version>0.8.13</jacoco.plugin.version>
    <sonar.plugin.version>5.1.0.4751</sonar.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <!-- Streaming JsonGenerator only (no databind): output is written
             field-by-field for deterministic ordering, never string-built. -->
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
      <dependency>
        <!-- D-10/D-28: AST + symbol resolution for the L0 oracle rules. Apache-2.0 option
             (RESEARCH.md), never the LGPL one - hard rule 9. Pulls javaparser-core and Guava
             transitively. -->
        <groupId>com.github.javaparser</groupId>
        <artifactId>javaparser-symbol-solver-core</artifactId>
        <version>${javaparser.version}</version>
      </dependency>
      <dependency>
        <!-- D-55: coverage-phase-only caller (DefaultCoverageGenerator +
             CoverageData.createCoverage()), never EntryPoint - the mutation
             phase this pulls in is never invoked. -->
        <groupId>org.pitest</groupId>
        <artifactId>pitest</artifactId>
        <version>${pitest.version}</version>
      </dependency>
      <dependency>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-entry</artifactId>
        <version>${pitest.version}</version>
      </dependency>
      <dependency>
        <!-- SPI-only: registers org.pitest.testapi.TestPluginFactory so PIT's
             own test discovery finds JUnit5 suites. Its META-INF/services
             file collides by name with pitest-core's JUnit4 registration -
             ServicesResourceTransformer in proof-java-cli's shade config
             merges them; see D-55. -->
        <groupId>org.pitest</groupId>
        <artifactId>pitest-junit5-plugin</artifactId>
        <version>${pitest.junit5.plugin.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <!-- project.build.sourceEncoding does not cover filtered .properties
               files (separate parameter); set both explicitly so this
               machine's Cp1254 platform default can never silently apply. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${resources.plugin.version}</version>
          <configuration>
            <encoding>UTF-8</encoding>
            <propertiesEncoding>UTF-8</propertiesEncoding>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${shade.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${dependency.plugin.version}</version>
        </plugin>
        <plugin>
          <!-- RELEASE-CONTRACT.md: NOTICE and the transitive dependency/license
               inventory are GENERATED at release build time, never hand-maintained.
               Bound in the `release` profile below, not the default build, so an
               ordinary `mvn verify` stays fast. -->
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>${license.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- coverdict's own coverage, consumed by the local SonarQube scan. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        RELEASE-CONTRACT.md's license/notice/integrity obligations, made real
        and executable (D-44). Deliberately a profile, not the default build:
        `mvn verify` runs on every change and must stay fast, while these
        goals resolve the full transitive tree and are only meaningful when an
        artifact is actually being shipped.

        Run with: mvn -P release clean package
      -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>license-maven-plugin</artifactId>
            <executions>
              <execution>
                <!-- The full transitive dependency/license inventory. The
                     contract says a release with a missing or stale inventory
                     does not ship, so this is bound to the build rather than
                     produced by hand on release day. -->
                <id>inventory</id>
                <phase>generate-resources</phase>
                <goals><goal>aggregate-add-third-party</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/release</outputDirectory>
                  <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
                  <includeTransitiveDependencies>true</includeTransitiveDependencies>
                  <excludedScopes>test</excludedScopes>
                  <sortArtifactByName>true</sortArtifactByName>
                  <!-- Dual-licensed artifacts: which option coverdict elects.
                       See the file's own header - an election, not a bypass. -->
                  <overrideFile>${maven.multiModuleProjectDirectory}/license-overrides.properties</overrideFile>
                  <!-- hard rule 9 / D-20: LGPL must not appear at any scope.
                       The build fails rather than shipping an artifact whose
                       own generated inventory contradicts the policy - the
                       first automated enforcement of that rule. -->
                  <failOnBlacklist>true</failOnBlacklist>
                  <!-- LITERAL license names, pipe-separated - NOT a regex.
                       Verified empirically: a regex form (".*LGPL.*") matched
                       nothing at all and the gate silently passed, which is
                       worse than no gate. These strings are the ones this
                       dependency tree actually produces; a new LGPL artifact
                       whose pom spells it differently would need its spelling
                       added here, so the negative test below is what keeps
                       this honest rather than the list being exhaustive. -->
                  <excludedLicenses>GNU Lesser General Public License|GNU Lesser General Public License (LGPL)|GNU Lesser General Public License, Version 2.1|GNU Lesser General Public License v3.0|LGPL|LGPL 2.1|LGPL-2.1|LGPL-3.0|GNU Library General Public License</excludedLicenses>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
