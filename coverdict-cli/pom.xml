<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.coverdict</groupId>
    <artifactId>coverdict-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>coverdict-cli</artifactId>
  <name>coverdict-cli</name>
  <description>Command line entry point and exit-code contract.</description>

  <dependencies>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-symbol-solver-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.pitest</groupId>
      <artifactId>pitest</artifactId>
    </dependency>
    <dependency>
      <groupId>org.pitest</groupId>
      <artifactId>pitest-entry</artifactId>
    </dependency>
    <dependency>
      <groupId>org.pitest</groupId>
      <artifactId>pitest-junit5-plugin</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Test-only: asserts real analyzer output against schema/coverdict-verdict.schema.json -->
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <!-- Test-only: where the fixture-harness jars (K4) land, kept off the real
         compile/test classpath deliberately - see the maven-dependency-plugin
         execution below and OracleRuleEngineTest, which loads them with a
         standalone JarTypeSolver. -->
    <fixture.harness.dir>${project.build.directory}/fixture-harness</fixture.harness.dir>
  </properties>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- K4: downloads the fixture-harness API jars (JUnit 4/5, AssertJ, Mockito,
             Hamcrest, Truth) fixtures/rules/** compiles against, without declaring any of
             them as a project dependency - so coverdict's own oracle engine tests
             exercise the same classpath-less resolution path a real user run does,
             plus a proof of the JarTypeSolver mechanism a future classpath option will reuse. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-fixture-harness</id>
            <phase>generate-test-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>junit</groupId>
                  <artifactId>junit</artifactId>
                  <version>${fixture.junit4.version}</version>
                </artifactItem>
                <artifactItem>
                  <groupId>org.assertj</groupId>
                  <artifactId>assertj-core</artifactId>
                  <version>${fixture.assertj.version}</version>
                </artifactItem>
                <artifactItem>
                  <groupId>org.mockito</groupId>
                  <artifactId>mockito-core</artifactId>
                  <version>${fixture.mockito.version}</version>
                </artifactItem>
                <artifactItem>
                  <groupId>org.hamcrest</groupId>
                  <artifactId>hamcrest</artifactId>
                  <version>${fixture.hamcrest.version}</version>
                </artifactItem>
                <artifactItem>
                  <groupId>com.google.truth</groupId>
                  <artifactId>truth</artifactId>
                  <version>${fixture.truth.version}</version>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${fixture.harness.dir}</outputDirectory>
              <stripVersion>true</stripVersion>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>coverdict</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.coverdict.cli.Main</mainClass>
                </transformer>
                <!-- D-55: pitest-core and pitest-junit5-plugin both ship
                     META-INF/services/org.pitest.testapi.TestPluginFactory
                     under the same name (JUnit4 vs JUnit5 registration); the
                     default shade behavior keeps only one, silently dropping
                     JUnit5 test discovery. Same collision risk for
                     MutationResultListenerFactory (pitest-entry vs
                     pitest-html-report, the latter not a dependency here but
                     worth the general merge). -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        Assembles the release bundle RELEASE-CONTRACT.md promises (D-44):
        the executable jar, a generated NOTICE, the transitive
        dependency/license inventory, and SHA-256SUMS over all of them.
        Runs after shade (package phase) and consumes the inventory the
        parent's license-maven-plugin execution already produced - in a
        reactor the parent's generate-resources precedes this module's
        package.

        Run with: mvn -P release clean package
      -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>release-bundle</id>
                <phase>package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <property name="releaseDir" value="${maven.multiModuleProjectDirectory}/target/release"/>
                    <property name="inventory" value="${releaseDir}/THIRD-PARTY.txt"/>

                    <!-- The contract's "a release with a missing or stale
                         inventory does not ship" is only real if its absence
                         stops the build. -->
                    <fail message="THIRD-PARTY.txt missing - run the release profile from the reactor root so the inventory is generated first">
                      <condition>
                        <not><available file="${inventory}"/></not>
                      </condition>
                    </fail>

                    <!-- NOTICE is generated, never hand-maintained: a fixed
                         header plus the freshly generated inventory, so it
                         cannot go stale relative to the actual dependency
                         tree. -->
                    <concat destfile="${releaseDir}/NOTICE" encoding="UTF-8" outputencoding="UTF-8">
                      <fileset file="${basedir}/../src/release/NOTICE-header.txt"/>
                      <fileset file="${inventory}"/>
                    </concat>

                    <copy file="${project.build.directory}/coverdict.jar" todir="${releaseDir}"/>
                    <copy file="${maven.multiModuleProjectDirectory}/LICENSE" todir="${releaseDir}"/>

                    <!-- Integrity: every artifact ships a SHA-256SUMS file.
                         Ant's <checksum> writes the bare digest with no file
                         name, which is not a verifiable sumfile - `sha256sum
                         -c` cannot read it. So the digest is captured into a
                         property per file and the two-column format is written
                         explicitly, matching validation/SHA256SUMS's own
                         layout so one `sha256sum -c` works on both. -->
                    <checksum algorithm="SHA-256" property="jar.sha256" file="${releaseDir}/coverdict.jar"/>
                    <checksum algorithm="SHA-256" property="notice.sha256" file="${releaseDir}/NOTICE"/>
                    <checksum algorithm="SHA-256" property="thirdparty.sha256" file="${releaseDir}/THIRD-PARTY.txt"/>
                    <checksum algorithm="SHA-256" property="license.sha256" file="${releaseDir}/LICENSE"/>
                    <echo file="${releaseDir}/SHA-256SUMS" encoding="UTF-8" append="false">${license.sha256} *LICENSE${line.separator}${notice.sha256} *NOTICE${line.separator}${thirdparty.sha256} *THIRD-PARTY.txt${line.separator}${jar.sha256} *coverdict.jar${line.separator}</echo>

                    <echo message="Release bundle ready: ${releaseDir}"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        Runs MutationRunnerIT: a real PIT mutation run against coverdict's
        own repo (minutes, not milliseconds - the default mvn verify must
        stay fast). *IT.java doesn't match Surefire's default include
        patterns, so this profile's own execution is the only way it runs.

        Run with: mvn -Pmutation-it -pl coverdict-cli test
      -->
      <id>mutation-it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>mutation-it</id>
                <phase>test</phase>
                <goals><goal>test</goal></goals>
                <configuration>
                  <includes>
                    <include>**/*IT.java</include>
                  </includes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
