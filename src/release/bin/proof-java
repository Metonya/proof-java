#!/usr/bin/env bash
# Thin wrapper so the release is invoked as `proof-java <args>`, the same
# shape as any other CLI, instead of `java -jar proof-java.jar <args>`.
# Resolves the jar next to this script - the two ship together in the same
# release archive and must stay side by side.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec java -jar "$DIR/proof-java.jar" "$@"
