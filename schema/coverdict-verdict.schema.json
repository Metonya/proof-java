{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coverdict.dev/schema/coverdict-verdict/0.1.0",
  "title": "coverdict verdict",
  "description": "Output contract of the coverdict CLI (experimental during 0.x, D-01). Deterministic: no timestamps or machine-local absolute paths; two clean runs on the same inputs are byte-identical. Ordering rules (all lexicographic by UTF-8 code point unless stated): inputs.modules by id; changedFiles by (module, path); findings by (path, startLine, rule, fingerprint); warnings and analysis.incompleteReasons by (code, path, message); perTest.modules by id; perTest entries and ambient by (className, methodName); lines by line ascending; tests lexicographic; mutation.modules by id; mutation methods by (className, methodName, methodDescription); mutants by (line, mutator, status); killingTests lexicographic; fileCoverage.files by (module, path); fileCoverage.files[].lines by line ascending; fileCoverage.excluded lexicographic. All paths are repo-relative with forward slashes. Percentages are rounded half-up to one decimal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "analysis",
    "inputs",
    "coverage",
    "changedFiles",
    "findings",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "coverdict"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exitCode",
        "incompleteReasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "exitCode": {
          "enum": [
            0,
            3
          ]
        },
        "incompleteReasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      },
      "description": "status=complete requires exitCode 0 and empty incompleteReasons; status=incomplete requires exitCode 3 and at least one reason. Exit codes 2 and 4 abort before a verdict document is written."
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diffMode",
        "findingsScope",
        "languageLevel",
        "encoding",
        "exclusions",
        "modules"
      ],
      "properties": {
        "diffMode": {
          "enum": [
            "base-ref",
            "working-tree",
            "no-vcs"
          ]
        },
        "findingsScope": {
          "enum": [
            "all",
            "changed"
          ],
          "description": "Which test sources the L0 oracle rules scanned (M1b K1): 'all' (default) is every test source under every module's testRoots; 'changed' is only test files touched by the diff. Always written so an empty findings array is never ambiguous between 'nothing wrong' and 'nothing scanned'."
        },
        "baseRef": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head",
            "dirty"
          ],
          "properties": {
            "base": {
              "$ref": "#/$defs/sha"
            },
            "mergeBase": {
              "$ref": "#/$defs/sha"
            },
            "head": {
              "$ref": "#/$defs/sha"
            },
            "dirty": {
              "type": "boolean"
            }
          },
          "description": "Present unless diffMode=no-vcs. base and mergeBase present only in base-ref mode (D-16)."
        },
        "languageLevel": {
          "type": "integer",
          "minimum": 8
        },
        "encoding": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "newCode"
      ],
      "properties": {
        "overall": {
          "$ref": "#/$defs/metricSet"
        },
        "newCode": {
          "oneOf": [
            {
              "$ref": "#/$defs/metricSet"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "unavailable_no_vcs",
                    "unavailable_incomplete"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changedFile"
      },
      "description": "Every changed Java path appears exactly once (M1c criterion 3). Empty in no-vcs mode."
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reason"
      }
    },
    "perTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engineVersion",
        "modules"
      ],
      "properties": {
        "engine": {
          "const": "pitest"
        },
        "engineVersion": {
          "type": "string",
          "minLength": 1
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/perTestModule"
          }
        }
      },
      "description": "Opt-in L2 evidence (--per-test-report, D-46/D-55): present only when the flag was set, absent (never null) otherwise. Never a finding source on its own - COVERAGE_EQUIVALENT_CANDIDATE requires L0+L2+L3 together (D-46)."
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engineVersion",
        "modules"
      ],
      "properties": {
        "engine": {
          "const": "pitest"
        },
        "engineVersion": {
          "type": "string",
          "minLength": 1
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutationModule"
          }
        }
      },
      "description": "Opt-in L3 evidence (--mutation-report, D-56/M5): present only when the flag was set, absent (never null) otherwise. Mutants come from PIT's own RETURNS+VOID_METHOD_CALLS gregor mutators, a gregor approximation of Descartes' extreme mutation (Descartes itself is never a dependency, hard rule 9). Never a finding source on its own - COVERAGE_EQUIVALENT_CANDIDATE requires L0+L2+L3 together (D-46)."
    },
    "fileCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "excluded"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileCoverageEntry"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "description": "Repo-relative paths ExclusionFilter removed from the filtered dataset - shown as explicitly excluded (hard rule 3a), never as unknown or uncovered."
        }
      },
      "description": "Opt-in, whole-repo, line-level coverage of every filtered source file (--file-coverage, IDE surface Plan.md Faz 1): present only when the flag was set, absent (never null) otherwise. Every metric here is the same MetricsEngine output coverage.overall is computed from, scoped to one file - never a client-side recomputation."
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\]*$",
      "description": "Repo-relative, forward slashes, no leading ./"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "module": {
          "type": "string"
        },
        "count": {
          "description": "Optional machine-readable quantity for reasons that are inherently about how many (SUPPRESSED_FINDINGS). Absent for every other reason.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "root",
        "sourceRoots",
        "testRoots",
        "reports"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "$ref": "#/$defs/path"
        },
        "sourceRoots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "testRoots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "reports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "freshness"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "freshness": {
                "enum": [
                  "unverified",
                  "verified"
                ]
              }
            }
          }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numeratorName",
        "numerator",
        "denominatorName",
        "denominator",
        "percent"
      ],
      "properties": {
        "numeratorName": {
          "type": "string",
          "minLength": 1
        },
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominatorName": {
          "type": "string",
          "minLength": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "percent": {
          "type": [
            "number",
            "null"
          ],
          "description": "null when denominator is 0 \u2014 never reported as 100 or 0 by convention (hard rule 3a)"
        }
      }
    },
    "metricSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jacoco-line",
        "strict-line",
        "sonar-compatible"
      ],
      "properties": {
        "jacoco-line": {
          "$ref": "#/$defs/metric"
        },
        "strict-line": {
          "$ref": "#/$defs/metric"
        },
        "sonar-compatible": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "classification"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "description": "Omitted (never null) when classification=unknown because the path is not under any declared module root (D-27)."
        },
        "classification": {
          "enum": [
            "mapped",
            "excluded",
            "non-executable",
            "unsupported",
            "unknown"
          ]
        },
        "newLines": {
          "type": "integer",
          "minimum": 0
        },
        "coveredNewLines": {
          "type": "integer",
          "minimum": 0
        },
        "uncoveredNewRanges": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Closed line ranges [start, end], ascending, non-overlapping. Line-count fields are present only for classification=mapped."
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "confidence",
        "module",
        "path",
        "startLine",
        "endLine",
        "message",
        "suggestedAction",
        "fingerprint"
      ],
      "properties": {
        "rule": {
          "enum": [
            "NO_RECOGNIZED_ORACLE",
            "TAUTOLOGICAL_ORACLE",
            "CATCH_ORACLE_WITHOUT_FAIL",
            "NULL_CHECK_ONLY",
            "PSEUDO_TESTED_METHOD",
            "SUBSUMED_TEST"
          ]
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING"
          ]
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "INCONCLUSIVE"
          ],
          "description": "Detector certainty, separate from severity (D-17). Unresolved symbols cap at MEDIUM/INCONCLUSIVE."
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "testMethod": {
          "type": "string",
          "minLength": 1,
          "description": "Fully qualified test method signature when the finding anchors to one"
        },
        "productionMethod": {
          "type": "string",
          "minLength": 1,
          "description": "Fully qualified production method signature when the finding anchors to one instead (M5's PSEUDO_TESTED_METHOD; mutually exclusive with testMethod in v0.1's rule set)"
        },
        "relatedTestMethod": {
          "type": "string",
          "minLength": 1,
          "description": "M4's SUBSUMED_TEST only: the dominator test whose mutant kill-set is a strict superset of the primary testMethod's - the test that makes the primary one redundant under the mutators this run exercised (D-61). Null for every other rule."
        },
        "relatedPath": {
          "$ref": "#/$defs/path",
          "description": "M4's SUBSUMED_TEST only: repo-relative path of relatedTestMethod's source file. Null for every other rule."
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "suggestedAction": {
          "type": "string",
          "minLength": 1,
          "description": "Plain-language next step. Never suggests deletion below HIGH confidence (hard rule 3); v0.1 rules never suggest deletion at all."
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,64}$",
          "description": "Stable across runs and unrelated edits; definition per rule spec (M0 deliverable 4)"
        }
      }
    },
    "perTestModule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entries",
        "ambient"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/perTestEntry"
          }
        },
        "ambient": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/perTestEntry"
          },
          "description": "D-50: static-initializer coverage (method <clinit>), never test-attributable, kept separate from entries."
        }
      }
    },
    "perTestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "className",
        "methodName",
        "lines"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "methodName": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/perTestLine"
          }
        }
      }
    },
    "perTestLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "tests"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mutationModule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "methods"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutatedMethod"
          }
        }
      }
    },
    "mutatedMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "className",
        "methodName",
        "methodDescription",
        "firstLine",
        "lastLine",
        "mutants"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "methodName": {
          "type": "string",
          "minLength": 1
        },
        "methodDescription": {
          "type": "string",
          "minLength": 1,
          "description": "JVM method descriptor (e.g. '(II)I') - disambiguates overloads sharing a name"
        },
        "firstLine": {
          "type": "integer",
          "minimum": 1
        },
        "lastLine": {
          "type": "integer",
          "minimum": 1
        },
        "mutants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutant"
          }
        }
      }
    },
    "mutant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutator",
        "line",
        "status",
        "killingTests"
      ],
      "properties": {
        "mutator": {
          "type": "string",
          "minLength": 1,
          "description": "PIT gregor mutator id (e.g. NULL_RETURNS, VOID_METHOD_CALLS)"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "KILLED",
            "SURVIVED",
            "TIMED_OUT",
            "NON_VIABLE",
            "MEMORY_ERROR",
            "NOT_STARTED",
            "STARTED",
            "RUN_ERROR",
            "NO_COVERAGE"
          ],
          "description": "PIT's own DetectionStatus name, verified via javap against pitest 1.15.8"
        },
        "killingTests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Every test that killed this mutant (setFullMutationMatrix(true)), not just the first - M4's redundancy gate needs the full kill set. Empty for a SURVIVED or NO_COVERAGE mutant."
        }
      }
    },
    "fileCoverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "path",
        "metrics",
        "lines"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "metrics": {
          "$ref": "#/$defs/metricSet"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1,
                "description": "Source line number"
              },
              {
                "type": "integer",
                "minimum": 0,
                "description": "missedInstructions"
              },
              {
                "type": "integer",
                "minimum": 0,
                "description": "coveredInstructions"
              },
              {
                "type": "integer",
                "minimum": 0,
                "description": "missedBranches"
              },
              {
                "type": "integer",
                "minimum": 0,
                "description": "coveredBranches"
              }
            ],
            "minItems": 5,
            "maxItems": 5
          },
          "description": "Compact [line, mi, ci, mb, cb] tuples, ascending by line - same field order and meaning as JacocoXmlParser's LineCoverage (D-04's jacoco-line/strict-line membership, D-19)."
        }
      }
    }
  }
}
